// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Branch {
  id          String   @id @default(cuid())
  name        String
  address     String?
  phone       String?
  users   User[]

  members     Member[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Member {
  id         String   @id @default(cuid())
  name       String
  phone      String   @unique
  gender     Gender

  joinDate   DateTime
  expiryDate DateTime

  plan       PlanType
  amountPaid Float

  branchId   String
  branch     Branch @relation(fields: [branchId], references: [id])

  payments   Payment[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Payment {
  id          String   @id @default(cuid())
  amount      Float
  paymentDate DateTime @default(now())
  plan        PlanType

  memberId    String
  member      Member @relation(fields: [memberId], references: [id])
}

enum PlanType {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum UserRole {
  ADMIN
  STAFF
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(STAFF)

  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

